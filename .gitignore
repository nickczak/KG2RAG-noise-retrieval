# Local Python environments and generated bytecode
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Machine-specific configuration and credentials
.env
.env.*
!.env.example
/.aws/
.kateproject.notes
.DS_Store

# Show experiment folders and small research records in Git/Kate.
# Ignore graphs, checkpoints, smoke artifacts, source snapshots, and raw logs.
/output/*
!/output/README.md
!/output/*/
/output/*/*
!/output/*/README.md
!/output/*/experiment.json
!/output/*/run_settings.json
!/output/*/hotpot*.json
!/output/*/selection.json
!/output/*/config.json
!/output/*/metrics.json
!/output/*/summary.json
!/output/*/score_reuse.json
!/output/*/usage.json
!/output/*/evidence_review.json
!/output/*/gnn_mrl.json
!/output/*/timing.json
!/output/*/provenance.json
!/output/*/predictions.json
!/output/*/environment.txt
!/output/*/commit.txt
!/output/*/ollama-version.txt
!/output/*/ollama-models.txt

# Original one-question smoke artifacts remain local.
/output/smoke/*
!/output/smoke/README.md

# Downloaded model weights; retain existing model documentation
/model/*
!/model/readme.md

# Extracted graphs and local model caches
/data/**/kgs/
/.cache/

# HotpotQA training source and local GNN checkpoints are reproducible artifacts,
# too large or machine-specific to commit. Keep the experiment notes visible.
/output/gnn_train/hotpot_train.json
/output/gnn_train/*.pt
